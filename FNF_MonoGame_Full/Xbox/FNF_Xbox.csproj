<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <AppDesignedForPhone>false</AppDesignedForPhone>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <TargetPlatformVersion Condition=" '$(TargetPlatformVersion)' == '' ">10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <RootNamespace>FNF_MonoGame</RootNamespace>
    <AssemblyName>FNF_Xbox</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NuGetPackageImportStamp></NuGetPackageImportStamp>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);XBOX_UWP</DefineConstants>
    <RuntimeIdentifiers>win10-x64;win10-x64-aot;win10-x86;win10-arm;win10</RuntimeIdentifiers>
    <!-- Suppress NuGet .NET Framework dependency check (false positive from netstandard2.0 packages) -->
    <SkipValidatePackageReferences>true</SkipValidatePackageReferences>
    <_PackagingOutputsIncludesFramework>true</_PackagingOutputsIncludesFramework>
    <PlatformTarget>x64</PlatformTarget>
    <PackageCertificateThumbprint>4CAC51A51E00A2284D67C5246DAECAD2787D5607</PackageCertificateThumbprint>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <DebugSymbols>true</DebugSymbols>
    <OutputPath>bin\x64\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UAP;XBOX_UWP</DefineConstants>
    <Optimize>false</Optimize>
    <UseDotNetNativeToolchain>false</UseDotNetNativeToolchain>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <OutputPath>bin\x64\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UAP;XBOX_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>

  <!-- Link all source files from the main project -->
  <ItemGroup>
    <!-- Root -->
    <!-- FNFGame.cs excluded — replaced by XboxGame.cs for UWP -->
    <!-- Program.cs excluded — UWP generates its own entry point -->
    <!-- AudioManager.cs excluded — uses NAudio (Win32 only), replaced by XboxAudioManager.cs -->
    <!-- Engine -->
    <Compile Include="..\Engine\AssetManager.cs" Link="Engine\AssetManager.cs" />
    <Compile Include="..\Engine\InputManager.cs" Link="Engine\InputManager.cs" />
    <Compile Include="..\Engine\HighscoreManager.cs" Link="Engine\HighscoreManager.cs" />
    <Compile Include="..\Engine\SceneManager.cs" Link="Engine\SceneManager.cs" />
    <Compile Include="..\Engine\SpriteSheet.cs" Link="Engine\SpriteSheet.cs" />
    <Compile Include="..\Engine\AlphabetFont.cs" Link="Engine\AlphabetFont.cs" />
    <!-- AudioManager.cs excluded — uses NAudio (Win32 only), replaced by XboxAudioManager.cs -->
    <!-- Gameplay -->
    <Compile Include="..\Gameplay\Chart.cs" Link="Gameplay\Chart.cs" />
    <Compile Include="..\Gameplay\Character.cs" Link="Gameplay\Character.cs" />
    <Compile Include="..\Gameplay\NoteField.cs" Link="Gameplay\NoteField.cs" />
    <Compile Include="..\Gameplay\Conductor.cs" Link="Gameplay\Conductor.cs" />
    <!-- Scenes -->
    <Compile Include="..\Scenes\PlayScene.cs" Link="Scenes\PlayScene.cs" />
    <Compile Include="..\Scenes\MainMenuScene.cs" Link="Scenes\MainMenuScene.cs" />
    <Compile Include="..\Scenes\TitleScene.cs" Link="Scenes\TitleScene.cs" />
    <Compile Include="..\Scenes\FreeplayScene.cs" Link="Scenes\FreeplayScene.cs" />
    <Compile Include="..\Scenes\StoryModeScene.cs" Link="Scenes\StoryModeScene.cs" />
    <Compile Include="..\Scenes\ResultsScene.cs" Link="Scenes\ResultsScene.cs" />
    <Compile Include="..\Scenes\OptionsScene.cs" Link="Scenes\OptionsScene.cs" />
    <Compile Include="..\Scenes\CharacterSelectScene.cs" Link="Scenes\CharacterSelectScene.cs" />
    <Compile Include="..\Scenes\CreditsScene.cs" Link="Scenes\CreditsScene.cs" />
    <!-- Xbox-specific -->
    <Compile Include="App.xaml.cs">
      <DependentUpon>App.xaml</DependentUpon>
    </Compile>
    <Compile Include="GamePage.xaml.cs">
      <DependentUpon>GamePage.xaml</DependentUpon>
    </Compile>
    <Compile Include="XboxAudioManager.cs" />
    <Compile Include="XboxGame.cs" />
    <Compile Include="ContentDownloader.cs" />
    <Compile Include="LoadingScene.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="UwpPolyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="GamePage.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- NO content in MSIX — keeps package tiny (~4MB) for instant Xbox startup.
       Content files are uploaded separately to Xbox via Dev Portal File Explorer:
       Browse to: LocalState/Content/ and upload the entire Content folder there.
       The game reads from LocalState/Content/ at runtime. -->

  <!-- Store assets -->
  <ItemGroup>
    <Content Include="Assets\**\*" />
    <Content Include="..\Content\fonts\DS-DIGIT.TTF" Link="Content\fonts\DS-DIGIT.TTF" />
    <Content Include="..\Content\fonts\DS-DIGI.TTF" Link="Content\fonts\DS-DIGI.TTF" />
    <Content Include="..\Content\fonts\DS-DIGIB.TTF" Link="Content\fonts\DS-DIGIB.TTF" />
    <Content Include="..\Content\fonts\DS-DIGII.TTF" Link="Content\fonts\DS-DIGII.TTF" />
  </ItemGroup>

  <!-- Code signing certificate -->
  <ItemGroup>
    <None Include="mohammad_aljafari.pfx" />
    <None Include="mohammad_aljafari.cer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.WindowsUniversal" Version="3.8.1.303" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.7" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="System.IO.Compression" Version="4.3.0" />
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
    <PackageReference Include="Microsoft.NETCore.Portable.Compatibility" Version="1.0.1" />
  </ItemGroup>


  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '14.0' ">
    <VisualStudioVersion>14.0</VisualStudioVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildExtensionsPath)\Microsoft\WindowsXaml\v$(VisualStudioVersion)\Microsoft.Windows.UI.Xaml.CSharp.targets" />
</Project>
